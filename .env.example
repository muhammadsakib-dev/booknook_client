# ==============================================================================
# BookNook Frontend (Next.js 16 + BetterAuth) Environment Variables Template
# ==============================================================================
# In Production (Vercel), add these variables in your Vercel Dashboard.
# NO "NEXT_PUBLIC_" prefix needed!
# ==============================================================================

# Express Backend Base URL
# Local: http://localhost:8000
# Production: https://<your-backend-app>.onrender.com
API_URL=http://localhost:8000

# Next.js Application Public URL
# Local: http://localhost:3000
# Production: https://<your-frontend-app>.vercel.app
APP_URL=http://localhost:3000
# BETTER_AUTH_URL is optional; it defaults automatically to APP_URL
# BETTER_AUTH_URL=http://localhost:3000

# BetterAuth Cryptographic Secret (Minimum 32 random characters)
# Must match BETTER_AUTH_SECRET on the Express backend!
BETTER_AUTH_SECRET=your_super_secret_32_character_encryption_key_here

# MongoDB Connection String (Used by BetterAuth MongoDB Adapter)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Google OAuth Configuration (Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
