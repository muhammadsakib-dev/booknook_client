# ==============================================================================
# BookNook Frontend (Next.js 16 + BetterAuth) Environment Variables Template
# ==============================================================================
# NOTE: Copy this file to .env.local for local development.
# NEVER commit .env or .env.local containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BROWSER-VISIBLE ENVIRONMENT VARIABLES (Prefix: NEXT_PUBLIC_)
# Accessible in both client components and server code.
# ------------------------------------------------------------------------------

# Express Backend Base URL (do not add a trailing slash)
# Local: http://localhost:8000
# Production: https://booknook-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Next.js Application Public URL
# Local: http://localhost:3000
# Production: https://booknook-client.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY ENVIRONMENT VARIABLES
# Strictly hidden from browser bundles; accessible only in Server Components,
# Route Handlers, and BetterAuth server context.
# ------------------------------------------------------------------------------

# BetterAuth Server Base URL (matches NEXT_PUBLIC_APP_URL)
BETTER_AUTH_URL=http://localhost:3000

# BetterAuth Cryptographic Secret (Minimum 32 random characters)
# Must match the BETTER_AUTH_SECRET configured on the Express backend!
# Generate using: openssl rand -base64 32
BETTER_AUTH_SECRET=your_super_secret_32_character_encryption_key_here

# MongoDB Connection String (Used by BetterAuth MongoDB Adapter)
# Replica set URI (e.g. MongoDB Atlas)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Optional: MongoDB Database Name (defaults to 'assignment-08' if omitted)
MONGODB_DB_NAME=assignment-08

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH CONFIGURATION (Google Cloud Console)
# Server-only credentials obtained from Google Cloud Console > APIs & Services > Credentials
# ------------------------------------------------------------------------------

# Authorized JavaScript Origins:
# Local: http://localhost:3000
# Production: https://<your-vercel-domain>.vercel.app

# Authorized Redirect URIs:
# Local: http://localhost:3000/api/auth/callback/google
# Production: https://<your-vercel-domain>.vercel.app/api/auth/callback/google

GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

